# Firmware build-time configuration.
#
# Copy this file to firmware/.env and set the provisioning AP password.
# firmware/.env is git-ignored; tools/fw-common.sh loads it for build, flash
# and OTA-export commands, and tools/fw-build.sh compiles the values into the
# image. Variables already present in the environment take precedence.
#
# WPA2 requires 8-63 characters. If the password must contain whitespace,
# define AK_AP_PASSWORD in firmware/sketches/receiver/secrets.h instead.
#
# Example:
# AK_AP_PASSWORD=my-site-ap-password
AK_AP_PASSWORD=
