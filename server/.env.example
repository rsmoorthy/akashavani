AKASHAVANI_ENVIRONMENT=development
AKASHAVANI_DATABASE_URL=sqlite:///./data/akashavani.db
AKASHAVANI_DATA_DIR=./data
AKASHAVANI_FIRMWARE_DIR=./data/firmware
AKASHAVANI_DEVICE_SEEDS=station-1:dev-station-1-token:Bench station 1
AKASHAVANI_ADMIN_TOKEN=dev-admin-token
AKASHAVANI_API_TOKEN=secret
AKASHAVANI_RAIN_BUCKET_MM=0.254
AKASHAVANI_LOG_LEVEL=INFO

# Public read-only dashboard. Off by default; enable deliberately and set the
# station slug used by /dashboard. The optional allowlist contains device IDs.
AKASHAVANI_PUBLIC_DASHBOARD_ENABLED=false
AKASHAVANI_PUBLIC_DEFAULT_SLUG=
AKASHAVANI_PUBLIC_DEVICE_IDS=
AKASHAVANI_PUBLIC_MAX_RANGE_DAYS=31
AKASHAVANI_PUBLIC_CACHE_SECONDS=60
AKASHAVANI_DASHBOARD_DIR=./dashboard/dist

# Docker Compose only: UID/GID for the image's non-root `app` user. They are
# build args, not AKASHAVANI_ settings, and take effect on the next
# `make docker-build`. Set them to the owner of the host directory that is
# bind-mounted over /data; otherwise the container cannot create
# akashavani.db ("unable to open database file").
UID=1000
GID=1000
