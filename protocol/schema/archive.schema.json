{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akashavani.local/schema/archive.schema.json",
  "title": "Five-minute archive record",
  "description": "One SI 5-minute collation sent by the receiver to POST /api/v1/archive. The server divides sums by counts and computes the derived Weewx-compatible values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "device_id",
    "message_id",
    "bucket_end_epoch",
    "interval_minutes",
    "sums",
    "counts",
    "wind_dir",
    "wind_gust",
    "rain",
    "latest",
    "quality"
  ],
  "properties": {
    "v": { "const": 1 },
    "type": { "const": "archive" },
    "device_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,31}$" },
    "message_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "bucket_end_epoch": { "type": "integer", "minimum": 1 },
    "interval_minutes": { "type": "integer", "minimum": 1, "maximum": 60 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": { "const": "davis" },
        "channel": { "type": "integer", "minimum": 0, "maximum": 255 },
        "transmitter_id": { "type": "integer", "minimum": 1, "maximum": 8 },
        "rssi_dbm": { "type": "integer", "minimum": -200, "maximum": 0 }
      }
    },
    "sums": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "out_temp_c": { "type": ["number", "null"] },
        "out_humidity_pct": { "type": ["number", "null"] },
        "pressure_hpa": { "type": ["number", "null"] },
        "in_temp_c": { "type": ["number", "null"] },
        "in_humidity_pct": { "type": ["number", "null"] },
        "wind_speed_m_s": { "type": ["number", "null"] },
        "uv_index": { "type": ["number", "null"] },
        "solar_wm2": { "type": ["number", "null"] }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "out_temp": { "type": "integer", "minimum": 0 },
        "out_humidity": { "type": "integer", "minimum": 0 },
        "pressure": { "type": "integer", "minimum": 0 },
        "in_temp": { "type": "integer", "minimum": 0 },
        "in_humidity": { "type": "integer", "minimum": 0 },
        "wind_speed": { "type": "integer", "minimum": 0 },
        "wind_dir": { "type": "integer", "minimum": 0 },
        "wind_gust": { "type": "integer", "minimum": 0 },
        "rain": { "type": "integer", "minimum": 0 },
        "solar": { "type": "integer", "minimum": 0 },
        "uv": { "type": "integer", "minimum": 0 },
        "supercap": { "type": "integer", "minimum": 0 }
      }
    },
    "wind_dir": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sin_sum": { "type": "number" },
        "cos_sum": { "type": "number" },
        "speed_sum": { "type": "number" }
      }
    },
    "wind_gust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_m_s": { "type": ["number", "null"] },
        "dir_deg": { "type": ["number", "null"] }
      }
    },
    "rain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tips": { "type": "integer", "minimum": 0 },
        "rate_raw": { "type": ["integer", "null"], "minimum": 0, "maximum": 1023 },
        "rate_high": { "type": "boolean" },
        "rate_valid": { "type": "boolean" }
      }
    },
    "latest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "battery_low": { "type": "boolean" },
        "supercap_v": { "type": ["number", "null"] },
        "supercap_min_v": { "type": ["number", "null"] }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frames_expected": { "type": "integer", "minimum": 0 },
        "frames_valid": { "type": "integer", "minimum": 0 },
        "frames_crc_bad": { "type": "integer", "minimum": 0 },
        "resync_count": { "type": "integer", "minimum": 0 },
        "search_count": { "type": "integer", "minimum": 0 },
        "gap_slots": { "type": "integer", "minimum": 0 },
        "max_gap_slots": { "type": "integer", "minimum": 0 },
        "rssi_avg_dbm": { "type": ["number", "null"] },
        "rssi_min_dbm": { "type": ["number", "null"] },
        "rssi_max_dbm": { "type": ["number", "null"] },
        "crc_bad_rssi_min_dbm": { "type": ["number", "null"] },
        "crc_bad_rssi_avg_dbm": { "type": ["number", "null"] },
        "crc_bad_rssi_max_dbm": { "type": ["number", "null"] }
      }
    }
  }
}
