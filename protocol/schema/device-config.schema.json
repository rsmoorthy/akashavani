{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akashavani.local/schema/device-config.schema.json",
  "title": "Device configuration document",
  "description": "Reported by the device with PUT /api/v1/devices/me/config and sent back with the push_config command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "timezone"],
  "properties": {
    "version": {
      "const": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "IANA display time zone. Storage and transport are UTC."
    },
    "site": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["latitude", "longitude", "altitude_m"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "altitude_m": { "type": "number", "minimum": -500, "maximum": 9000 }
      }
    },
    "wifi": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ssid", "password"],
        "properties": {
          "ssid": { "type": "string", "minLength": 1, "maxLength": 32 },
          "password": { "type": "string", "maxLength": 63 }
        }
      }
    },
    "admin_password": { "type": "string", "maxLength": 32 },
    "upload_enabled": { "type": "boolean" },
    "archive_enabled": { "type": "boolean" },
    "upload_interval_seconds": { "type": "integer", "minimum": 10, "maximum": 86400 },
    "command_poll_interval_seconds": { "type": "integer", "minimum": 10, "maximum": 3600 }
  }
}
